# Install-Cafe.cmd creates this configuration automatically on Windows.
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:change_me@127.0.0.1:5432/cafe
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_random_secret_of_at_least_32_characters
# false for the local HTTP network; true only when HTTPS is configured.
COOKIE_SECURE=false
# Optional backup configuration; use forward slashes in Windows paths.
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
# BACKUP_DIR=D:/CafeBackups
# Development only: Vite API proxy destination.
# API_TARGET=http://127.0.0.1:3000
